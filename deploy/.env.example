PDK_DB_PASSWORD=replace-with-a-long-random-password
PDK_ADMIN_PASSWORD_PEPPER=replace-with-a-long-random-pepper
PDK_SECURITY_ROOT_SALT=replace-with-a-long-random-root-salt
PDK_TRIAL_SMS_CODE=replace-or-connect-real-sms-provider
PDK_ENABLED_BIZ_CODES=PDD,ZHIBO
# 仅使用 64 位十六进制随机值，避免 URL 转义问题：openssl rand -hex 32
PDK_MEDIAMTX_INTERNAL_SERVICE_TOKEN=replace-with-64-hex-characters
PDK_MEDIAMTX_PUBLIC_RTMP_BASE_URL=rtmp://localhost:1935
PDK_MEDIAMTX_RTMP_PORT=1935

# 客户端升级（四个 secret 必须分别生成，不得与登录加密/管理员 pepper 共用）
PDK_UPDATE_STORAGE_ROOT=/var/lib/pdk-client-updates
PDK_UPDATE_PUBLIC_BASE_URL=https://updates.example.com
PDK_UPDATE_DOWNLOAD_TOKEN_SECRET=replace-with-independent-64-hex-secret
PDK_UPDATE_EVENT_TOKEN_SECRET=replace-with-independent-64-hex-secret
PDK_UPDATE_ROLLOUT_HMAC_SECRET=replace-with-independent-64-hex-secret
PDK_UPDATE_ROLLOUT_KEY_VERSION=1
# PKCS#8 DER / X.509 DER 的 Base64；使用 scripts/generate_update_keys.py 生成。
PDK_UPDATE_ARTIFACT_PRIVATE_KEY=
PDK_UPDATE_ARTIFACT_KEY_ID=client-release-2026-01
PDK_UPDATE_POLICY_PRIVATE_KEY=
PDK_UPDATE_POLICY_KEY_ID=client-policy-2026-01
PDK_UPDATE_MAX_FILE_SIZE=512MB
